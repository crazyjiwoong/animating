{
  "name": "amg",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "start": "vite build && electron .",
    "web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.59.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "description": "AMG(Aㅐ니 Mㅏㄴ들Gㅣ 힘들어서 직접 만듬) — 누구나 쉽게 만들 수 있는 초보자들을 위한 애니메이션 툴",
  "author": "AMG",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.amg.animation",
    "productName": "AMG",
    "copyright": "AMG",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "fileAssociations": [
      {
        "ext": "amg",
        "name": "AMG 프로젝트",
        "description": "AMG 애니메이션 프로젝트",
        "role": "Editor"
      },
      {
        "ext": "ffanim",
        "name": "AMG 프로젝트 (이전 형식)",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AMG",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AMG-Setup-Windows.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "artifactName": "AMG-macOS.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "AMG-Linux.${ext}",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AMG-Portable-Windows.${ext}"
    }
  }
}
